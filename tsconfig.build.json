{
  "//": "Declaration emit for the published build (scripts/build.mjs). Tests are covered by tsconfig.json.",
  "extends": "./tsconfig.json",
  "compilerOptions": { "emitDeclarationOnly": true, "declaration": true, "declarationMap": false, "sourceMap": false, "noEmit": false },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
