{
  "name": "@pagehub/sdk",
  "version": "0.1.9",
  "description": "PageHub's shared chrome and site utilities: modals and confirm dialogs, popovers, the media library UI, the CSS compile, theme tokens and CSS, icon resolution and the email CSS/text helpers.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    "./theme.css": "./src/css/theme.css",
    "./themes/shadcn.css": "./src/css/themes/shadcn.css",
    "./chrome.css": "./src/css/chrome.css",
    "./compile-css": "./src/compile-css/index.ts",
    "./email-renderer": "./src/render/email/index.ts",
    "./page-settings/fields": "./src/page-settings/fields.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/view": "^6.41.0",
    "@floating-ui/react-dom": "^2.1.8",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "prettier": "^3.8.3",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/lang-css": {
      "optional": true
    },
    "@codemirror/lang-html": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@floating-ui/react-dom": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@uiw/react-codemirror": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@pagehub/daisyui-spatial": "workspace:*",
    "@tailwindcss/node": "^4.2.2",
    "dompurify": "^3.4.16",
    "htmlparser2": "^9.1.0",
    "lightningcss": "^1.32.0",
    "lzutf8": "^0.6.3",
    "postcss": "^8.5.10",
    "react-icons": "^5.6.0",
    "react-image-crop": "^11.1.2",
    "slug": "^11.0.1",
    "style-to-object": "^1.0.14",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/view": "^6.41.0",
    "@floating-ui/react-dom": "^2.1.8",
    "@lezer/highlight": "^1.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "daisyui": "^5.5.19",
    "esbuild": "0.28.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dashboard-chrome",
    "modal",
    "tailwind",
    "design-tokens",
    "icons",
    "email"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PageHubApp/sdk"
  },
  "homepage": "https://pagehub.dev",
  "bugs": {
    "url": "https://github.com/PageHubApp/sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./theme.css": "./dist/css/theme.css",
      "./themes/shadcn.css": "./dist/css/themes/shadcn.css",
      "./chrome.css": "./dist/css/chrome.css",
      "./compile-css": {
        "types": "./dist/compile-css/index.d.ts",
        "import": "./dist/compile-css/index.js"
      },
      "./email-renderer": {
        "types": "./dist/render/email/index.d.ts",
        "import": "./dist/render/email/index.js"
      },
      "./page-settings/fields": {
        "types": "./dist/page-settings/fields.d.ts",
        "import": "./dist/page-settings/fields.js"
      },
      "./chrome/*": {
        "types": "./dist/chrome/*.d.ts",
        "import": "./dist/chrome/*.js"
      },
      "./utils/*": {
        "types": "./dist/utils/*.d.ts",
        "import": "./dist/utils/*.js"
      },
      "./package.json": "./package.json"
    }
  }
}
